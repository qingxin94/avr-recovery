#
# system.prop for Lenovo Legion Y70 (avr)
#

# USB controller (from init.recovery.qcom.rc default)
ro.boot.hardware=qcom
ro.hardware=qcom

# FBE
ro.crypto.volume.filenames_mode=aes-256-cts
ro.crypto.fs_crypto_blkdev=/dev/block/sda
ro.crypto.fde_available=false
ro.crypto.fbe_available=true
ro.crypto.type=file

# Boot
ro.boot.slot_suffix=
ro.boot.vbmeta.device_state=unlocked

# UFS
ro.storage.type=ufs

# Display recovery framebuffer (confirmed panel: 3168x1440 WQHD+ vtdr6130 AMOLED 144Hz)
# Use real panel resolution as vfb fallback so TWRP fills screen when DRM not ready
video=vfb:3168x1440,bpp=32,memsize=25165824

# Disable properties that may cause issues in recovery
ro.debuggable=1
ro.secure=0
ro.adb.secure=0
